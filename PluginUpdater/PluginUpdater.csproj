<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1">
      <Private>false</Private>
    </PackageReference>
    <PackageReference Include="LibGit2Sharp" Version="0.30.0">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
      <Private>false</Private>
    </PackageReference>
  </ItemGroup>

  <!-- Include our bundled LibGit2Sharp dependencies -->
  <ItemGroup>
    <None Include="NativeDependencies\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameHelper\GameHelper.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\GameOffsets\GameOffsets.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyFiles" AfterTargets="Build">
    <!-- Copy main plugin files -->
    <Copy SourceFiles="$(OutDir)$(TargetName)$(TargetExt);$(OutDir)$(TargetName).pdb;" DestinationFolder="..\GameHelper\$(OutDir)Plugins\$(ProjectName)" SkipUnchangedFiles="true"/>
    
    <!-- Copy PluginStore.json -->
    <Copy SourceFiles="PluginStore.json" DestinationFolder="..\GameHelper\$(OutDir)Plugins\$(ProjectName)" SkipUnchangedFiles="true"/>
    
    <!-- Copy our bundled LibGit2Sharp dependencies -->
    <ItemGroup>
      <LibGit2SharpLib Include="$(OutDir)NativeDependencies\LibGit2Sharp.dll" />
      <LibGit2SharpNative Include="$(OutDir)NativeDependencies\runtimes\**\*.*" />
    </ItemGroup>
    
    <!-- Copy LibGit2Sharp main library to plugin folder AND GameHelper root -->
    <Copy SourceFiles="@(LibGit2SharpLib)" DestinationFolder="..\GameHelper\$(OutDir)Plugins\$(ProjectName)" SkipUnchangedFiles="true"/>
    <Copy SourceFiles="@(LibGit2SharpLib)" DestinationFolder="..\GameHelper\$(OutDir)" SkipUnchangedFiles="true"/>
    
    <!-- Copy LibGit2Sharp native binaries to plugin folder -->
    <Copy SourceFiles="@(LibGit2SharpNative)" DestinationFiles="@(LibGit2SharpNative->'..\GameHelper\$(OutDir)Plugins\$(ProjectName)\runtimes\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
    
    <!-- Copy LibGit2Sharp native binaries to GameHelper root -->
    <Copy SourceFiles="@(LibGit2SharpNative)" DestinationFiles="@(LibGit2SharpNative->'..\GameHelper\$(OutDir)runtimes\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
  </Target>

</Project>